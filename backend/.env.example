# Copier ce fichier en .env (ou définir ces variables directement dans les
# "Environment Variables" de Render) — NE JAMAIS committer de vraies valeurs.

# Base de données PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<database>
SPRING_DATASOURCE_USERNAME=<user>
SPRING_DATASOURCE_PASSWORD=<password>

# Ne PAS laisser Hibernate gérer le schéma en production après le premier
# déploiement : préférer "validate" une fois les tables créées, pour éviter
# toute modification accidentelle du schéma au démarrage.
DDL_AUTO=update

# Secret JWT : générer une valeur aléatoire forte, par ex. :
#   openssl rand -base64 48
JWT_SECRET=<valeur-aleatoire-longue>
JWT_EXPIRATION=86400000

# Domaine(s) exact(s) du frontend déployé, séparés par des virgules
CORS_ALLOWED_ORIGINS=https://<votre-frontend>.onrender.com

# Compte admin créé au premier démarrage (à changer immédiatement après connexion)
ADMIN_EMAIL=admin@cabinet-acte.com
ADMIN_PASSWORD=<mot-de-passe-fort>

# Port d'écoute (Render l'injecte automatiquement, ne pas définir manuellement sur Render)
PORT=8080
