# .gitignore for Spring Boot + Maven + IDE

# =====================================================
# IDE
# =====================================================
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.code-workspace
.DS_Store
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
local.properties

# =====================================================
# MAVEN
# =====================================================
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
.mvn/wrapper/MavenWrapperDownloader.java

# =====================================================
# GRADLE
# =====================================================
.gradle
build/
*.gradle
!gradle/wrapper/gradle-wrapper.jar

# =====================================================
# NODE / FRONTEND
# =====================================================
node_modules/
npm-debug.log
yarn-error.log
dist/
.env.local
.env.*.local

# =====================================================
# COMPILED / OUTPUT
# =====================================================
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar
*.log

# =====================================================
# OS
# =====================================================
Thumbs.db
.DS_Store

# =====================================================
# APPLICATION SPECIFIC
# =====================================================
application-local.properties
application-dev.properties
application-prod.properties
.env
.env.local
src/main/resources/application-local.properties

# =====================================================
# DOCKER
# =====================================================
.dockerignore
Dockerfile
