package com.cabinet.acte.service.impl;

import com.cabinet.acte.dto.WeeklyReportDTO;
import com.cabinet.acte.entity.Employee;
import com.cabinet.acte.entity.Task;
import com.cabinet.acte.repository.EmployeeRepository;
import com.cabinet.acte.repository.ErrorLogRepository;
import com.cabinet.acte.repository.TaskRepository;
import com.cabinet.acte.service.ReportService;
import com.lowagie.text.*;
import com.lowagie.text.pdf.PdfPCell;
import com.lowagie.text.pdf.PdfPTable;
import com.lowagie.text.pdf.PdfWriter;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.awt.Color;
import java.io.ByteArrayOutputStream;
import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.List;
import java.util.stream.Collectors;

@Service
@Transactional(readOnly = true)
public class ReportServiceImpl implements ReportService {

    @Autowired
    private TaskRepository taskRepository;

    @Autowired
    private EmployeeRepository employeeRepository;

    @Autowired
    private ErrorLogRepository errorLogRepository;

    private static final DateTimeFormatter FR_DATE = DateTimeFormatter.ofPattern("dd/MM/yyyy");

    private LocalDate resolveWeekStart(LocalDate weekStart) {
        if (weekStart != null) return weekStart;
        LocalDate today = LocalDate.now();
        return today.minusDays(today.getDayOfWeek().getValue() - 1L);
    }

    @Override
    public WeeklyReportDTO getWeeklyReport(LocalDate weekStart) {
        LocalDate start = resolveWeekStart(weekStart);
        LocalDate end = start.plusDays(6);

        List<Task> weekTasks = taskRepository.findAll().stream()
            .filter(t -> t.getDueDate() != null && !t.getDueDate().isBefore(start) && !t.getDueDate().isAfter(end))
            .collect(Collectors.toList());

        long tasksPlanned = weekTasks.size();
        long tasksInProgress = weekTasks.stream().filter(t -> t.getStatus() == Task.TaskStatus.IN_PROGRESS).count();
        long tasksCompleted = weekTasks.stream().filter(t -> t.getStatus() == Task.TaskStatus.DONE).count();

        List<Employee> employees = employeeRepository.findAll();
        List<Task> allTasks = taskRepository.findAll();

        List<WeeklyReportDTO.EmployeeWeeklySummary> summaries = employees.stream()
            .map(employee -> {
                long completed = allTasks.stream()
                    .filter(t -> employee.getId().equals(t.getAssignedTo()))
                    .filter(t -> t.getStatus() == Task.TaskStatus.DONE)
                    .filter(t -> t.getUpdatedAt() != null
                        && !t.getUpdatedAt().toLocalDate().isBefore(start)
                        && !t.getUpdatedAt().toLocalDate().isAfter(end))
                    .count();
                long errors = errorLogRepository.countByEmployeeIdAndDateBetween(employee.getId(), start, end);
                return new WeeklyReportDTO.EmployeeWeeklySummary(employee.getId(), employee.getName(), completed, errors);
            })
            .collect(Collectors.toList());

        return new WeeklyReportDTO(start, end, tasksPlanned, tasksInProgress, tasksCompleted, summaries);
    }

    @Override
    public byte[] exportWeeklyReportPdf(LocalDate weekStart, Long employeeId) {
        WeeklyReportDTO report = getWeeklyReport(weekStart);

        List<WeeklyReportDTO.EmployeeWeeklySummary> summaries = report.getEmployeeSummaries();
        if (employeeId != null) {
            summaries = summaries.stream()
                .filter(s -> employeeId.equals(s.getEmployeeId()))
                .collect(Collectors.toList());
        }

        try {
            ByteArrayOutputStream out = new ByteArrayOutputStream();
            Document document = new Document(PageSize.A4, 40, 40, 50, 50);
            PdfWriter.getInstance(document, out);
            document.open();

            Font titleFont = new Font(Font.HELVETICA, 18, Font.BOLD);
            Font sectionFont = new Font(Font.HELVETICA, 13, Font.BOLD);
            Font normalFont = new Font(Font.HELVETICA, 11);

            document.add(new Paragraph("Bilan hebdomadaire — Cabinet ACTe / MissionFlow", titleFont));
            document.add(new Paragraph(
                "Semaine du " + report.getWeekStart().format(FR_DATE) + " au " + report.getWeekEnd().format(FR_DATE),
                normalFont
            ));
            document.add(Chunk.NEWLINE);

            document.add(new Paragraph("Résumé", sectionFont));
            document.add(new Paragraph("Tâches planifiées : " + report.getTasksPlanned(), normalFont));
            document.add(new Paragraph("Tâches en cours : " + report.getTasksInProgress(), normalFont));
            document.add(new Paragraph("Tâches terminées : " + report.getTasksCompleted(), normalFont));
            document.add(Chunk.NEWLINE);

            document.add(new Paragraph("Détail par employé", sectionFont));
            document.add(Chunk.NEWLINE);

            PdfPTable table = new PdfPTable(3);
            table.setWidthPercentage(100);
            table.addCell(headerCell("Employé"));
            table.addCell(headerCell("Tâches terminées"));
            table.addCell(headerCell("Erreurs"));

            for (WeeklyReportDTO.EmployeeWeeklySummary summary : summaries) {
                table.addCell(new PdfPCell(new Phrase(summary.getEmployeeName(), normalFont)));
                table.addCell(new PdfPCell(new Phrase(String.valueOf(summary.getTasksCompleted()), normalFont)));
                table.addCell(new PdfPCell(new Phrase(String.valueOf(summary.getErrorsCount()), normalFont)));
            }
            document.add(table);

            document.close();
            return out.toByteArray();
        } catch (DocumentException e) {
            throw new RuntimeException("Erreur lors de la génération du PDF: " + e.getMessage(), e);
        }
    }

    private PdfPCell headerCell(String text) {
        PdfPCell cell = new PdfPCell(new Phrase(text, new Font(Font.HELVETICA, 11, Font.BOLD)));
        cell.setBackgroundColor(new Color(0, 102, 204));
        cell.setPadding(6);
        Font whiteFont = new Font(Font.HELVETICA, 11, Font.BOLD, Color.WHITE);
        cell.setPhrase(new Phrase(text, whiteFont));
        return cell;
    }
}
