* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

.login-page {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  background: #f5f7fa;
  font-family: 'Segoe UI', system-ui, sans-serif;
  padding: 20px;
}

/* Carte */
.login-card {
  background: #ffffff;
  border-radius: 24px;
  padding: 40px 36px 32px;
  width: 100%;
  max-width: 380px;
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
  animation: fadeUp 0.5s ease;
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Marque */
.login-brand {
  text-align: center;
  margin-bottom: 28px;
}
.login-brand h1 {
  font-weight: 600;
  font-size: 1.8rem;
  color: #0b1e33;
  letter-spacing: -0.02em;
  margin: 0;
}
.login-brand p {
  color: #6b7f94;
  font-size: 0.95rem;
  margin: 4px 0 0;
}

/* Erreur */
.login-error {
  background: #fef2f2;
  border: 1px solid #fecaca;
  border-radius: 10px;
  padding: 10px 14px;
  margin-bottom: 20px;
  color: #b91c1c;
  font-size: 0.9rem;
  display: flex;
  align-items: center;
  gap: 6px;
}
.error-icon {
  font-weight: 700;
}

/* Champs */
.login-form {
  display: flex;
  flex-direction: column;
  gap: 18px;
}
.field-group {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.field-group label {
  font-weight: 500;
  font-size: 0.9rem;
  color: #1e2f44;
  display: flex;
  align-items: center;
  gap: 8px;
}
.field-icon {
  color: #8a9fb5;
  font-size: 0.9rem;
}
.field-group input {
  width: 100%;
  padding: 10px 14px;
  border: 1.5px solid #e2e8f0;
  border-radius: 12px;
  font-size: 1rem;
  background: #fafbfc;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.field-group input:focus {
  outline: none;
  border-color: #1a5cff;
  box-shadow: 0 0 0 4px rgba(26, 92, 255, 0.06);
  background: #fff;
}
.field-group input::placeholder {
  color: #a8bccf;
}

/* Bouton */
.btn-login {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  padding: 12px;
  background: #1a5cff;
  color: white;
  border: none;
  border-radius: 40px;
  font-weight: 600;
  font-size: 1rem;
  cursor: pointer;
  transition: background 0.2s, transform 0.1s;
  margin-top: 6px;
}
.btn-login:hover:not(:disabled) {
  background: #0f47cc;
}
.btn-login:active:not(:disabled) {
  transform: scale(0.97);
}
.btn-login:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* Infos démo */
.login-help {
  margin-top: 24px;
  padding-top: 16px;
  border-top: 1px solid #edf2f7;
  text-align: center;
  font-size: 0.85rem;
  color: #6b7f94;
  display: flex;
  justify-content: center;
  gap: 6px;
  flex-wrap: wrap;
}
.help-sep {
  color: #cbd5e1;
}

/* Responsive */
@media (max-width: 420px) {
  .login-card {
    padding: 28px 20px 24px;
  }
  .login-brand h1 {
    font-size: 1.6rem;
  }
}
